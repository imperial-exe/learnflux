# LearnFlux AI — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your Supabase project credentials.
# Get these from: https://supabase.com → Your Project → Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Project URL (e.g. https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous / Public Key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Without these values, the app runs in offline localStorage mode.
# All features still work — data is stored in your browser only.
# ─────────────────────────────────────────────────────────────────────────────
